{
  // Source roots to analyze.
  "include": [
    "packages",
    "apps",
    "tests"
  ],
  // Keep caches, build artifacts, and virtualenvs out of the analysis set.
  // "**/*.pyc" is intentionally omitted: pyright only analyzes .py/.pyi
  // files, so that pattern would be dead configuration.
  "exclude": [
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "**/.ruff_cache",
    "**/.tox",
    "**/.nox",
    "**/.venv",
    "**/venv",
    "**/build",
    "**/dist",
    "**/*.egg-info",
    "**/node_modules",
    "**/.*"
  ],
  // Every package declares requires-python = ">=3.12", so pin the analysis
  // target to the minimum supported interpreter for consistent results.
  "pythonVersion": "3.12",
  // Explicit baseline so effective strictness stays stable across pyright
  // upgrades (the framework default is "standard").
  "typeCheckingMode": "standard",
  // Monorepo: each package uses a hatch src/ layout, so expose every
  // package root to let cross-package imports (and package tests) resolve
  // without installing the packages into an interpreter. Declared at the top
  // level so every execution environment inherits it.
  "extraPaths": [
    "packages/pfa-ir-schema/src",
    "packages/pfa-fx/src",
    "packages/pfa-parser/src",
    "packages/pfa-ir-consolidator/src",
    "packages/pfa-ir-verifier/src",
    "packages/pfa-analysis/src",
    "apps/pfa-cli/src"
  ],
  "executionEnvironments": [
    {
      // Default environment: strict checks for all packages.
      "root": ".",
      "reportUnusedImport": "warning",
      "reportUnusedVariable": "warning",
      "reportExplicitAny": "error"
    },
    {
      // pfa-parser depends on pdfplumber (and pulls in pandas / click in
      // places), which ship little typing metadata. Keep its checks permissive;
      // tighten gradually as type coverage improves.
      "root": "packages/pfa-parser",
      "reportAny": "none",
      "reportExplicitAny": "none",
      "reportUnknownVariableType": "none",
      "reportUnknownArgumentType": "none",
      "reportUnknownMemberType": "none",
      "reportMissingTypeStubs": "none",
      "reportTypedDictNotRequiredAccess": "none"
    }
  ]
}